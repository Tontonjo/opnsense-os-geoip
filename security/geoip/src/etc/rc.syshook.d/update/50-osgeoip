#!/bin/sh
#
# 50-osgeoip (update hook)
# Version: 2.0.0
#
# Applies the GeoIP plugin menu icon to the theme stylesheets again, since OPNsense
# updates restore the original theme files.

/usr/local/bin/python3 /usr/local/opnsense/scripts/OPNsense/OsGeoip/menu_icon.py install > /dev/null 2>&1

exit 0
